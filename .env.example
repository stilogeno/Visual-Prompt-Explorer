# Supabase Configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file with real credentials!

# Local Supabase instance (e.g. http://localhost:54321 or http://your-host:54321)
# Use 'localhost' or your machine's local IP for LAN connections
VITE_SUPABASE_URL=

# Supabase anon key (do NOT commit the actual .env file!)
# Get this from your Supabase project settings
VITE_SUPABASE_ANON_KEY=

# Cloud Supabase fallback (used when local Supabase is unreachable)
# Set these if you want cloud sync as a backup when local is offline
VITE_SUPABASE_CLOUD_URL=
VITE_SUPABASE_CLOUD_KEY=

# Optional: Override specific features
VITE_IMAGE_URL_EXPORT=false
VITE_DEBUG_MODE=false

# ============================================
# Quick Setup:
# 1. Copy .env.example to .env
# 2. Fill in your actual Supabase values
# 3. Run: npm run dev
# ============================================
